# ============================================================================
# Corazon Empire — environment variables
# Copy to .env.local for development. NEVER commit real values.
# ============================================================================

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------
# Canonical URL of the deployed site (no trailing slash). Used for metadata,
# sitemap, Open Graph and Supabase password-recovery redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (Project Settings → API)
# ---------------------------------------------------------------------------
# Safe to expose to the browser. RLS restricts what these keys can read/write.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only. Bypasses RLS — used by maintenance scripts and to record email
# delivery status. NEVER prefix with NEXT_PUBLIC_ and never import into client code.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Transactional email for order notifications (Resend)
# Without these, email ordering shows a clear "not configured" message and the
# customer is directed to WhatsApp. WhatsApp ordering works regardless.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be a verified sender/domain in Resend, e.g. "Corazon Empire <orders@yourdomain.com>"
ORDER_EMAIL_FROM=
# Where order notifications are delivered
ORDER_EMAIL_TO=omojuli001@gmail.com

# ---------------------------------------------------------------------------
# Sandbox / offline preview only
# When "1" and Supabase is unreachable, the storefront renders the bundled demo
# catalogue with a visible banner. Mutations never use the fallback.
# Leave unset (or 0) in production.
# ---------------------------------------------------------------------------
# DEMO_OFFLINE_FALLBACK=1

# ---------------------------------------------------------------------------
# One-time admin provisioning (scripts/provision-admin.mjs) — shell only.
# Do not create a .env file containing these values.
# ---------------------------------------------------------------------------
# ADMIN_EMAIL=omojuli001@gmail.com
# ADMIN_INITIAL_PASSWORD=
