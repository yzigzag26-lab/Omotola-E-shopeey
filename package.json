{
  "name": "corazon-empire",
  "version": "1.0.0",
  "private": true,
  "description": "Corazon Empire \u2014 luxury fashion & lifestyle e-commerce storefront with Supabase backend and admin dashboard.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "lint:secrets": "node scripts/check-secrets.mjs",
    "doctor": "node scripts/doctor.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint:secrets && npm run typecheck && npm run lint && npm run test && npm run build",
    "seed": "node scripts/seed.mjs",
    "upload-images": "node scripts/upload-images.mjs",
    "provision-admin": "node scripts/provision-admin.mjs",
    "verify:db": "node scripts/verify-db.mjs",
    "seed:sql": "node scripts/generate-seed-sql.mjs",
    "setup:sql": "node scripts/build-setup-sql.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
